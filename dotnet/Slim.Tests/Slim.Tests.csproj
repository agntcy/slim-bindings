<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Agntcy.Slim.Tests</RootNamespace>
    <AssemblyName>Agntcy.Slim.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.4" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Slim\Slim.csproj" />
  </ItemGroup>

  <!--
    Copy exactly one native library to the output, chosen by the RID of the machine
    running this build. Every runtimes/<rid>/native/ file links to the same output
    file name, so including several leaves the winner up to item ordering - which
    quietly placed a musl .so in a glibc test run once the Alpine RIDs started being
    populated. Alpine SDKs report linux-musl-*; the portable RID is a fallback for
    SDKs that do not set the non-portable one.
  -->
  <PropertyGroup>
    <SlimHostRid>$(NETCoreSdkRuntimeIdentifier)</SlimHostRid>
    <SlimHostRid Condition="'$(SlimHostRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</SlimHostRid>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="..\runtimes\$(SlimHostRid)\native\libuniffi_slim_bindings.dylib" Condition="Exists('..\runtimes\$(SlimHostRid)\native\libuniffi_slim_bindings.dylib')" CopyToOutputDirectory="PreserveNewest" Link="libuniffi_slim_bindings.dylib" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="..\runtimes\$(SlimHostRid)\native\libuniffi_slim_bindings.so" Condition="Exists('..\runtimes\$(SlimHostRid)\native\libuniffi_slim_bindings.so')" CopyToOutputDirectory="PreserveNewest" Link="libuniffi_slim_bindings.so" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="..\runtimes\$(SlimHostRid)\native\uniffi_slim_bindings.dll" Condition="Exists('..\runtimes\$(SlimHostRid)\native\uniffi_slim_bindings.dll')" CopyToOutputDirectory="PreserveNewest" Link="uniffi_slim_bindings.dll" />
  </ItemGroup>

</Project>
